# pacman's hooks do the rest after these functions: sysusers (20),
# tmpfiles (21), hwdb update (25, the guns' axes' filter) and udev reload
# with `udevadm trigger -c change` (35), on install, upgrade and removal.
# The user is created here already, so that the configuration can be given
# to it now.
_own_config() {
  systemd-sysusers
  chown root:sinden etc/sinden-driver
  chmod 0775 etc/sinden-driver
  chown sinden:sinden etc/sinden-driver/LightgunMono.exe.config
  chmod 0644 etc/sinden-driver/LightgunMono.exe.config
}

post_install() {
  _own_config
  echo ">>> Start the driver now and at boot:"
  echo ">>>   systemctl enable --now sinden-driver.service"
}

post_upgrade() {
  _own_config
  echo ">>> Restart the driver: systemctl try-restart sinden-driver.service"
}
