# pacman's sysusers and tmpfiles hooks run after these functions: create the
# user (member of group input) first, so that the configuration can be
# given to it now.
_own_config() {
  systemd-sysusers
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/*sinden*.conf 2>/dev/null || true
  chown root:sinden etc/sinden-driver etc/sinden-driver/LightgunMono.exe.config
  chmod 0775 etc/sinden-driver
}

post_install() {
  _own_config
  echo ">>> Start the driver now and at boot:"
  echo ">>>   systemctl enable --now sinden-driver.service"
  echo ">>> Replug the guns (or run 'udevadm trigger') so that the udev rule applies."
}

post_upgrade() {
  _own_config
  echo ">>> Restart the driver: systemctl try-restart sinden-driver.service"
}
