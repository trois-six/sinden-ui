#!/bin/sh
# sinden-driver pkg: command-line link, then the driver's own LaunchAgent
# (com.sinden-driver.agent) for the logged-in user: `service install` and
# `service start` run as that user, not as root. Other users run
# `sinden-driver service install` once.
set -e
bin="/Library/Application Support/SindenDriver/SindenDriver.app/Contents/MacOS/sinden-driver"

mkdir -p /usr/local/bin
ln -sf "$bin" /usr/local/bin/sinden-driver

user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ]; then
	uid=$(id -u "$user")
	# The bundle's path (not the link): the agent and the camera permission
	# belong to the bundle.
	launchctl asuser "$uid" sudo -u "$user" "$bin" service install
	launchctl asuser "$uid" sudo -u "$user" "$bin" service start || true
fi
exit 0
