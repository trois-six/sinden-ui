<?xml version="1.0" encoding="utf-8"?>
<!--
  sinden-driver configuration (Sinden's LightgunMono.exe.config format).

  Each setting is an <add key="..." value="..." /> line of <appSettings>.
  A missing key, or an empty value, takes the driver's default; booleans
  are 1 (on) or 0 (off). A key ending in P2 is the second player's value
  (without it, the key applies to both players).

  The tray application (sinden-driver-ui) edits this file through the
  driver; your comments and other lines are kept. The driver restarts the
  guns when a setting changes.

  Examples:
    <add key="Joystick" value="1" />         joystick mode (0: mouse and keyboard)
    <add key="LeftHanded" value="1" />       swap the left and right side buttons
    <add key="ResourceMode" value="low" />   max, medium or low
    <add key="EnableRecoil" value="1" />
-->
<configuration>
  <appSettings>
  </appSettings>
</configuration>
