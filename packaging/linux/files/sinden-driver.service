# sinden-driver systemd unit: FALLBACK copy.
#
# Packages install the unit that `sinden-driver service files` generates
# from the downloaded driver; this hand-written copy is used only when that
# is impossible (stub binaries, no binary runnable on the build host).
[Unit]
Description=Sinden light gun driver
Documentation=https://github.com/trois-six/sinden-ui
After=systemd-udevd.service

[Service]
Type=simple
User=sinden
Group=sinden
# /run/sinden-driver/control.sock (mode 0666) lives here.
RuntimeDirectory=sinden-driver
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/sinden-driver service run
Restart=on-failure
RestartSec=2

# The gun's serial port and camera are in group sinden (udev rule), its
# input nodes in group input (sysusers.d); set_config rewrites the
# configuration.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/sinden-driver
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
